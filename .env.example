# Copia este archivo a .env y ajusta los valores. Nunca subas .env al repositorio.
PORT=3000
DATABASE_URL="file:./dev.db"
SESSION_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
NODE_ENV=development
APP_URL=http://localhost:3000
ADMIN_EMAIL=admin@pixel-web.local
ADMIN_PASSWORD=Admin12345

# Correo para la recuperación de clave (opcional).
# Si se deja vacío, el enlace se muestra en la consola del servidor.
# Con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 y una "contraseña de aplicación" en SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Pixel Web <tu-correo@gmail.com>"
