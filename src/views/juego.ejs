<%- include('partials/header') %>

<section class="escenario" aria-label="Juego">
  <iframe id="visor" class="escenario-juego" title="<%= juego.titulo %>" src="<%= juego.url %>"
          sandbox="allow-scripts allow-same-origin allow-forms" allow="fullscreen; gamepad"></iframe>
  <div class="escenario-barra">
    <div>
      <h1><%= juego.titulo %></h1>
      <p><%= juego.categoria %><% if (promedio) { %> <%- include('partials/estrellas', { valor: promedio }) %><% } %></p>
    </div>
    <div class="en-linea">
      <button type="button" id="pantalla" class="secundario">Pantalla completa</button>
      <a class="boton secundario" href="<%= juego.url %>" target="_blank" rel="noopener">Abrir en otra pestaña</a>
    </div>
  </div>
</section>

<div class="detalle">
  <section class="bloque">
    <h2>Acerca del juego</h2>
    <p><%= juego.descripcion %></p>
    <p class="nota">Publicado el <%= juego.fechaPublicacion.toLocaleDateString('es-EC', { day: 'numeric', month: 'long', year: 'numeric' }) %>.</p>
    <p><a href="/catalogo">Ver más juegos</a></p>
  </section>

  <section class="bloque" aria-labelledby="valoracion">
    <h2 id="valoracion">Reseñas</h2>
    <div class="puntaje">
      <strong><%= promedio ? promedio.toFixed(1) : '–' %></strong>
      <span class="nota"><%= total === 0 ? 'Aún no hay reseñas' : `de 5, con ${total} reseña${total === 1 ? '' : 's'}` %></span>
    </div>

    <% if (locals.error) { %><p class="error" role="alert"><%= error %></p><% } %>

    <% if (miResena) { %>
      <div class="mi-resena">
        <p><strong>Tu reseña</strong> <%- include('partials/estrellas', { valor: miResena.calificacion }) %></p>
        <p><%= miResena.comentario %></p>
      </div>
    <% } else { %>
      <form method="post" action="/juegos/<%= juego.id %>/resenas" class="formulario" data-validar>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <fieldset class="calificador">
          <legend>Tu calificación</legend>
          <div class="calificador-opciones">
            <% [5, 4, 3, 2, 1].forEach(n => { %>
              <input type="radio" id="estrella-<%= n %>" name="calificacion" value="<%= n %>" required>
              <label for="estrella-<%= n %>" title="<%= n %> de 5">★<span class="sr-only"><%= n %> de 5</span></label>
            <% }) %>
          </div>
        </fieldset>
        <label>Comentario
          <textarea name="comentario" required minlength="3" maxlength="500" placeholder="¿Qué te pareció?"></textarea>
        </label>
        <div><button type="submit">Publicar reseña</button></div>
      </form>
    <% } %>

    <% if (resenas.length) { %>
      <h3 class="sr-only">Reseñas recientes</h3>
      <ul class="lista-resenas">
        <% resenas.forEach(r => { %>
          <li>
            <div class="resena-cabecera"><strong><%= r.usuario.nombre %></strong><%- include('partials/estrellas', { valor: r.calificacion }) %></div>
            <p><%= r.comentario %></p>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</div>
<%- include('partials/footer', { script: 'juego.js' }) %>
