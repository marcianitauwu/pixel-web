<%- include('partials/header') %>
<div class="encabezado-pagina">
  <div>
    <h1>Comunidad</h1>
    <p class="nota">Sala general. Habla con quien esté conectado ahora.</p>
  </div>
</div>
<div class="comunidad">
  <aside class="bloque conectados">
    <h2>Conectados <span id="conteo">0</span></h2>
    <ul id="usuarios" class="lista-simple"></ul>
  </aside>
  <section class="bloque chat" aria-label="Chat">
    <p id="estado" class="chat-estado" role="status">Conectando…</p>
    <ol id="mensajes" class="mensajes" aria-live="polite" data-yo="<%= usuario.id %>"></ol>
    <form id="formChat" class="chat-form">
      <label class="sr-only" for="texto">Mensaje</label>
      <input id="texto" maxlength="500" required autocomplete="off" placeholder="Escribe un mensaje">
      <button type="submit">Enviar</button>
    </form>
  </section>
</div>
<%- include('partials/footer', { script: 'chat.js' }) %>
