<%- include('partials/header') %>
<section class="portada-catalogo">
  <div>
    <h1>Pixel Web</h1>
    <p>Juegos guardados en la base de datos. El catálogo para jugar llega en la versión 3.</p>
  </div>
</section>

<% if (juegos.length === 0) { %>
  <div class="vacio">
    <h2>La base de datos está vacía</h2>
    <p>Ejecuta <code>npm run seed</code> para cargar los juegos de ejemplo.</p>
  </div>
<% } else { %>
  <ul class="galeria">
    <% juegos.forEach(j => { %>
      <li class="juego">
        <div class="juego-imagen"><img src="<%= j.portada %>" alt="" width="640" height="360" loading="lazy"></div>
        <div class="juego-cuerpo">
          <h2 class="juego-titulo"><%= j.titulo %></h2>
          <p class="juego-categoria"><%= j.categoria %></p>
        </div>
      </li>
    <% }) %>
  </ul>
<% } %>
<%- include('partials/footer') %>
